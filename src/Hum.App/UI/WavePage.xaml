<UserControl x:Class="Hum.App.UI.WavePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Hum.App.UI"
             xmlns:m="clr-namespace:Hum.App.Motion"
             Foreground="{StaticResource TextMain}" FontFamily="{StaticResource UiFont}">
    <StackPanel>
        <!-- source -->
        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="3">
            <UniformGrid Columns="2">
                <RadioButton x:Name="SrcYa" Style="{StaticResource Seg}" GroupName="wsrc" Content="Яндекс"/>
                <RadioButton x:Name="SrcSc" Style="{StaticResource Seg}" GroupName="wsrc" Content="SoundCloud"/>
            </UniformGrid>
        </Border>

        <ContentPresenter x:Name="TopSlot"/>

        <!-- not connected -->
        <Border x:Name="ConnectBox" Background="{StaticResource Panel}" CornerRadius="12" Padding="16" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ConnectTitle" Text="Яндекс не подключён" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="ConnectText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12"
                           Text="Войдите, и здесь появится ваш эфир и миксы."/>
                <Button x:Name="ConnectButton" Style="{StaticResource Bare}" HorizontalAlignment="Left" m:Press.Enabled="True">
                    <Border Background="{StaticResource TextMain}" CornerRadius="9" Padding="14,8">
                        <TextBlock Text="Подключить" Foreground="Black" FontWeight="SemiBold" FontSize="13"/>
                    </Border>
                </Button>
            </StackPanel>
        </Border>

        <StackPanel x:Name="WaveBox">
            <!-- the plain wave: one tap, no settings -->
            <Button x:Name="MyWave" Style="{StaticResource Bare}" Margin="0,12,0,0" m:Press.Enabled="True">
                <Border x:Name="MyWaveBg" CornerRadius="12" Padding="14,12" Background="{StaticResource Panel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="34" Height="34">
                            <Canvas Width="48" Height="48">
                                <Path x:Name="MyWaveRing" Data="{StaticResource HumRing}" Stroke="{StaticResource TextMain}" StrokeThickness="3.4"/>
                                <Path x:Name="MyWaveLine" Data="{StaticResource HumWave}" Stroke="{StaticResource TextMain}" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MyWaveTitle" Text="Мой эфир" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="MyWaveSub" Text="Просто то, что вам нравится. Без настроек" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock x:Name="MyWaveGlyph" Grid.Column="2" Text="&#xE768;" FontFamily="{StaticResource Glyphs}" FontSize="14" VerticalAlignment="Center" Margin="8,0,2,0"/>
                    </Grid>
                </Border>
            </Button>

            <StackPanel x:Name="MixBox">
                <Grid Margin="0,18,0,10">
                    <TextBlock Text="Миксы" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="PadHint" Text="Тяните точку" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
                <TextBlock Text="НАСТРОЕНИЕ" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                <WrapPanel x:Name="MoodChips"/>
                <ui:MoodPad x:Name="Pad" Margin="0,12,0,0"/>
                <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="3" Margin="0,8,0,0">
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="DivFav" Style="{StaticResource Seg}" GroupName="wdiv" Content="Знакомое"/>
                        <RadioButton x:Name="DivAny" Style="{StaticResource Seg}" GroupName="wdiv" Content="Любое"/>
                        <RadioButton x:Name="DivNew" Style="{StaticResource Seg}" GroupName="wdiv" Content="Новое"/>
                    </UniformGrid>
                </Border>
                <!-- «Характер и язык», «Подборки», «Занятия» -->
                <StackPanel x:Name="MoreGroups"/>
            </StackPanel>

            <!-- SoundCloud: no server-side wave settings, so HUM builds and filters the wave itself -->
            <StackPanel x:Name="ScBox" Visibility="Collapsed">
                <Grid Margin="0,18,0,0">
                    <TextBlock Text="Фильтры эфира" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="ScHint" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
                <StackPanel x:Name="ScGroups"/>
                <TextBlock Text="ЕЩЁ" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,16,0,8"/>
                <WrapPanel>
                    <ToggleButton x:Name="ScNoSets" Style="{StaticResource ChipCheck}" Content="Без длинных сетов"/>
                    <ToggleButton x:Name="ScOnlyNew" Style="{StaticResource ChipCheck}" Content="Только незнакомое"/>
                    <ToggleButton x:Name="ScFresh" Style="{StaticResource ChipCheck}" Content="Свежее, за год"/>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
