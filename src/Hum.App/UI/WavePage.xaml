<UserControl x:Class="Hum.App.UI.WavePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Hum.App.UI"
             xmlns:m="clr-namespace:Hum.App.Motion"
             Foreground="{DynamicResource TextMain}" FontFamily="{DynamicResource UiFont}">
    <!-- «Эфир», design A: a living ring around «Мой эфир», mood chips, round mixes, recent likes -->
    <StackPanel>
        <!-- hero -->
        <Grid x:Name="Hero" Height="300" Margin="-18,0">
            <!-- aurora: three soft colour clouds drifting behind the ring -->
            <Canvas x:Name="Aurora" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse x:Name="Blob1" Width="260" Height="260"/>
                <Ellipse x:Name="Blob2" Width="240" Height="240"/>
                <Ellipse x:Name="Blob3" Width="220" Height="220"/>
            </Canvas>
            <ui:HeroRings x:Name="Rings"/>
            <!-- source switch -->
            <Border Background="{DynamicResource Panel}" CornerRadius="{DynamicResource R10}" Padding="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,6,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SrcYa" Style="{StaticResource Seg}" GroupName="wsrc" Content="Яндекс" Width="86"/>
                    <RadioButton x:Name="SrcSc" Style="{StaticResource Seg}" GroupName="wsrc" Content="SoundCloud" Width="96"/>
                </StackPanel>
            </Border>
            <Button x:Name="TuneBtn" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,18,0" ToolTip="Настройки эфира" m:Press.Enabled="True"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="HeroName" Text="Мой эфир" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><ScaleTransform x:Name="NameScale"/></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="HeroSub" FontSize="13" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                <Button x:Name="HeroPlay" Style="{StaticResource PlayButton}" Width="62" Height="62" Margin="0,16,0,0" HorizontalAlignment="Center" m:Press.Enabled="True"/>
            </StackPanel>
        </Grid>

        <!-- not connected -->
        <Border x:Name="ConnectBox" Background="{DynamicResource Panel}" CornerRadius="12" Padding="16" Margin="0,4,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ConnectTitle" Text="Яндекс не подключён" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="ConnectText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <Button x:Name="ConnectButton" Style="{StaticResource Bare}" HorizontalAlignment="Left" m:Press.Enabled="True">
                    <Border Background="{DynamicResource Accent}" CornerRadius="{DynamicResource R9}" Padding="14,8">
                        <TextBlock Text="Подключить" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold" FontSize="13"/>
                    </Border>
                </Button>
            </StackPanel>
        </Border>

        <StackPanel x:Name="WaveBox">
            <!-- mood chips (Yandex) / vibes (SoundCloud), one scrolling row -->
            <ScrollViewer x:Name="ChipScroll" Style="{StaticResource BarlessScroll}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" m:SmoothScroll.Mode="Horizontal">
                <StackPanel x:Name="ChipRow" Orientation="Horizontal"/>
            </ScrollViewer>

            <!-- wave settings: the pad and character (Yandex) or the SoundCloud filters; opened by the tune button -->
            <Border x:Name="TuneBox" Background="{DynamicResource Panel}" CornerRadius="14" Padding="14" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel x:Name="YaTune">
                        <Grid>
                            <TextBlock Text="СВОЁ НАСТРОЕНИЕ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                            <TextBlock Text="тяните точку" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ui:MoodPad x:Name="Pad" Margin="0,10,0,0"/>
                        <Border Background="{DynamicResource Bg}" CornerRadius="{DynamicResource R10}" Padding="3" Margin="0,8,0,0">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="DivFav" Style="{StaticResource Seg}" GroupName="wdiv" Content="Знакомое"/>
                                <RadioButton x:Name="DivAny" Style="{StaticResource Seg}" GroupName="wdiv" Content="Любое"/>
                                <RadioButton x:Name="DivNew" Style="{StaticResource Seg}" GroupName="wdiv" Content="Новое"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="ScBox" Visibility="Collapsed">
                        <Grid>
                            <TextBlock Text="ФИЛЬТРЫ ЭФИРА" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                            <TextBlock x:Name="ScHint" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel x:Name="ScGroups"/>
                        <TextBlock Text="ЕЩЁ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,12,0,8"/>
                        <WrapPanel>
                            <ToggleButton x:Name="ScNoSets" Style="{StaticResource ChipCheck}" Content="Без длинных сетов"/>
                            <ToggleButton x:Name="ScOnlyNew" Style="{StaticResource ChipCheck}" Content="Только незнакомое"/>
                            <ToggleButton x:Name="ScFresh" Style="{StaticResource ChipCheck}" Content="Свежее, за год"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ContentPresenter x:Name="TopSlot"/>

            <!-- round mixes -->
            <Grid Margin="0,22,0,10">
                <TextBlock x:Name="MixTitle" Text="Миксы" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="MixCount" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>
            <ScrollViewer Style="{StaticResource BarlessScroll}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" m:SmoothScroll.Mode="Horizontal">
                <StackPanel x:Name="MixRow" Orientation="Horizontal"/>
            </ScrollViewer>

            <!-- recent likes -->
            <Grid Margin="0,22,0,6">
                <TextBlock Text="Недавние лайки" Style="{StaticResource SectionTitle}"/>
                <Button x:Name="AllLikes" Style="{StaticResource Bare}" HorizontalAlignment="Right" VerticalAlignment="Bottom" m:Press.Enabled="True">
                    <TextBlock Text="Все" Style="{StaticResource Caption}"/>
                </Button>
            </Grid>
            <ListBox x:Name="Recent" Style="{StaticResource TrackList}" Margin="-8,0" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
        </StackPanel>
    </StackPanel>
</UserControl>
