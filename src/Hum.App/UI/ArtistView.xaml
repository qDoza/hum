<UserControl x:Class="Hum.App.UI.ArtistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hum.App.Motion"
             Foreground="{DynamicResource TextMain}" FontFamily="{DynamicResource UiFont}">
    <!-- a Yandex artist: big photo, listeners, popular and all tracks -->
    <Border x:Name="Shade" CornerRadius="14" Background="{DynamicResource Bg}" ClipToBounds="True">
        <Grid x:Name="Root">
            <ScrollViewer x:Name="Scroll" Style="{StaticResource BarlessScroll}" m:SmoothScroll.Mode="Vertical"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid x:Name="Hero" Height="340" ClipToBounds="True">
                        <Rectangle x:Name="Photo" RenderTransformOrigin="0.5,0">
                            <Rectangle.Fill><ImageBrush x:Name="PhotoImg" Stretch="UniformToFill" AlignmentY="Top"/></Rectangle.Fill>
                            <Rectangle.RenderTransform><TransformGroup><ScaleTransform x:Name="PhotoScale"/><TranslateTransform x:Name="PhotoShift"/></TransformGroup></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Fade"/>
                        <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,22">
                            <TextBlock x:Name="NameText" FontSize="44" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SubText" FontSize="13" Foreground="#B8FFFFFF" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="PlayBtn" Style="{StaticResource Bare}" m:Press.Enabled="True">
                                    <Border Background="{DynamicResource Accent}" CornerRadius="{DynamicResource R10}" Padding="16,9">
                                        <TextBlock Text="Слушать" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}"/>
                                    </Border>
                                </Button>
                                <Button x:Name="WaveBtn" Style="{StaticResource Bare}" Margin="8,0,0,0" m:Press.Enabled="True">
                                    <Border Background="{DynamicResource Chip}" CornerRadius="{DynamicResource R10}" Padding="16,9">
                                        <TextBlock Text="Эфир по артисту" FontSize="13" FontWeight="SemiBold"/>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="24,8,24,24">
                        <TextBlock Text="Популярные треки" Style="{StaticResource SectionTitle}" Margin="0,12,0,8"/>
                        <ListBox x:Name="Popular" Style="{StaticResource TrackList}" Margin="-8,0" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                        <TextBlock x:Name="AllTitle" Text="Все треки" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Visibility="Collapsed"/>
                        <ListBox x:Name="All" Style="{StaticResource TrackList}" Margin="-8,0" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                        <TextBlock x:Name="Status" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,30,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="BackBtn" Style="{StaticResource Bare}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0" Width="36" Height="36" ToolTip="Назад (Esc)" m:Press.Enabled="True">
            </Button>
        </Grid>
    </Border>
</UserControl>
