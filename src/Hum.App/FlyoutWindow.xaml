<Window x:Class="Hum.App.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Hum.App.Motion"
        xmlns:ui="clr-namespace:Hum.App.UI"
        Title="HUM" Width="384" Height="656"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextMain}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Grid x:Name="Root" Margin="12" RenderTransformOrigin="0.85,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale"/>
                <TranslateTransform x:Name="RootShift"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border CornerRadius="14" Background="Black" Margin="1">
            <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.55"/></Border.Effect>
        </Border>

        <Border x:Name="Card" CornerRadius="14" Background="{StaticResource Bg}" BorderBrush="#2C2C2C" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <!-- header: pin · HUM · open window -->
                <Grid x:Name="TopRow" Margin="18,14,18,0">
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" HorizontalAlignment="Left" Content="&#xE718;" m:Press.Enabled="True" ToolTip="Не закрывать окно"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="48" Height="48">
                                <Path Data="{StaticResource HumRing}" Stroke="{StaticResource TextMain}" StrokeThickness="4"/>
                                <Path Data="{StaticResource HumWave}" Stroke="{StaticResource TextMain}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="HUM" FontSize="16" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.LayoutTransform><ScaleTransform ScaleX="1"/></TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                    <Button x:Name="OpenButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Content="&#xE8A7;" m:Press.Enabled="True" ToolTip="Открыть окном"/>
                </Grid>

                <!-- pages -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <ScrollViewer x:Name="WaveHost" Style="{StaticResource BarlessScroll}" m:SmoothScroll.Mode="Vertical"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ui:WavePage x:Name="Wave" Margin="18,0,18,18"/>
                    </ScrollViewer>
                    <ui:LikesPage x:Name="Likes" Margin="18,0,18,0" Visibility="Collapsed"/>
                    <ui:SearchPage x:Name="Search" Margin="18,0,18,0" Visibility="Collapsed"/>
                </Grid>

                <ui:NowPlaying x:Name="Mini" Grid.Row="2" Visibility="Collapsed"/>

                <!-- tabs -->
                <Border Grid.Row="3" Background="#0D0D0D" BorderBrush="#1F1F1F" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" Padding="6">
                    <Grid x:Name="TabHost">
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="TabBlob" Height="43" CornerRadius="10" Background="#1B1B1B"/>
                        </Canvas>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="TabWave" Style="{StaticResource Bare}" m:Press.Enabled="True">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                        <Canvas Width="48" Height="48">
                                            <Path Data="{StaticResource HumRing}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="4"/>
                                            <Path Data="{StaticResource HumWave}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Эфир" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabLikes" Grid.Column="1" Style="{StaticResource Bare}" m:Press.Enabled="True">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEB51;" FontFamily="{StaticResource Glyphs}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Любимое" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabSearch" Grid.Column="2" Style="{StaticResource Bare}" m:Press.Enabled="True">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Glyphs}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Поиск" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="Toast" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,14"
                        Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="10" Padding="12,8" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" FontSize="12" TextWrapping="Wrap" MaxWidth="300"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
