<UserControl x:Class="Hum.App.UI.LikesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Hum.App.Motion"
             Foreground="{DynamicResource TextMain}" FontFamily="{DynamicResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/>
        </Grid.RowDefinitions>
        <!-- head in the language of «Мой эфир»: big title over the sky, glass buttons, text tabs -->
        <Grid Margin="2,44,0,0">
            <StackPanel>
                <TextBlock Text="ВАША  МУЗЫКА" FontSize="11" FontWeight="SemiBold" Foreground="#A0FFFFFF"/>
                <TextBlock Text="Любимое" FontSize="44" FontWeight="Black" Margin="0,4,0,0" Foreground="White">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="CountText" FontSize="13" Foreground="#B8FFFFFF" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="ShuffleBtn" Style="{StaticResource GlassButton}" Content="&#xE8B1;" ToolTip="Перемешать" m:Press.Enabled="True"/>
                <Button x:Name="PlayAllBtn" Style="{StaticResource GlassButton}" Content="&#xE768;" ToolTip="Слушать по порядку" Width="60" Height="60" FontSize="18" Margin="10,0,0,0" m:Press.Enabled="True"/>
            </StackPanel>
        </Grid>
        <StackPanel x:Name="Filters" Grid.Row="1" Orientation="Horizontal" Margin="2,18,0,0">
            <RadioButton x:Name="FAll" Style="{StaticResource TextTab}" GroupName="lf" Content="Все" IsChecked="True"/>
            <RadioButton x:Name="FYa" Style="{StaticResource TextTab}" GroupName="lf" Content="Яндекс"/>
            <RadioButton x:Name="FSc" Style="{StaticResource TextTab}" GroupName="lf" Content="SoundCloud"/>
        </StackPanel>
        <TextBox x:Name="Query" Grid.Row="2" Style="{StaticResource Search}" Tag="Поиск в любимом" Margin="0,14,0,8"/>
        <ListBox x:Name="List" Grid.Row="3" Style="{StaticResource TrackList}" Margin="-8,0"/>
        <TextBlock x:Name="EmptyText" Grid.Row="3" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,40,20,0"/>
    </Grid>
</UserControl>

