<UserControl x:Class="Hum.App.UI.CoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Hum.App.UI"
             xmlns:m="clr-namespace:Hum.App.Motion"
             Foreground="{StaticResource TextMain}" FontFamily="{StaticResource UiFont}">
    <Border x:Name="Shade" CornerRadius="14" Background="{StaticResource Bg}">
        <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="BodyScale"/></Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- the cover, big, plus the player -->
            <StackPanel Margin="36,40,12,24" VerticalAlignment="Center">
                <Grid Width="340" Height="340" HorizontalAlignment="Left">
                    <Rectangle RadiusX="16" RadiusY="16" Fill="{StaticResource Chip}"/>
                    <Rectangle RadiusX="16" RadiusY="16">
                        <Rectangle.Fill><ImageBrush x:Name="Cover" Stretch="UniformToFill"/></Rectangle.Fill>
                        <Rectangle.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.6"/></Rectangle.Effect>
                    </Rectangle>
                </Grid>
                <TextBlock x:Name="Title" FontSize="24" FontWeight="Bold" Margin="0,22,0,0" TextTrimming="CharacterEllipsis" MaxWidth="340" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="4,0" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Tag" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                    </Border>
                    <TextBlock x:Name="Artist" FontSize="14" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                </StackPanel>
                <ui:NowPlaying x:Name="Player" Width="340" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- lyrics -->
            <Grid Grid.Column="1" Margin="12,24,40,24">
                <ScrollViewer x:Name="LyricsScroll" Style="{StaticResource BarlessScroll}" m:SmoothScroll.Mode="Vertical"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- top/bottom padding is set from code to half the viewport, so any line can sit in the middle -->
                    <StackPanel x:Name="Lines"/>
                </ScrollViewer>
                <StackPanel x:Name="NoLyrics" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,64">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Glyphs}" FontSize="28" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="NoLyricsText" Style="{StaticResource Caption}" FontSize="13" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280"/>
                </StackPanel>
            </Grid>

            <Button x:Name="CloseBtn" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" ToolTip="Закрыть (Esc)" m:Press.Enabled="True"/>
        </Grid>
    </Border>
</UserControl>
