<Window x:Class="Hum.App.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Вход" Width="480" Height="720" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextMain}">
    <Border Background="{DynamicResource Bg}" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="14" Margin="10">
        <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.55"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="Header" Margin="18,0,12,0" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="48" Height="48">
                            <Path Data="{StaticResource HumRing}" Stroke="{DynamicResource TextMain}" StrokeThickness="3.8"/>
                            <Path Data="{StaticResource HumWave}" Stroke="{DynamicResource TextMain}" StrokeThickness="3.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="HeaderText" Text="Вход" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CloseBtn" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" HorizontalAlignment="Right" ToolTip="Отмена"/>
            </Grid>
            <Border Grid.Row="1" Margin="8,0,8,8" CornerRadius="10" ClipToBounds="True" Background="#101010">
                <Grid>
                    <TextBlock x:Name="Wait" Text="Открываю страницу входа…" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <wv:WebView2 x:Name="Web" Visibility="Hidden"/>
                </Grid>
            </Border>
            <TextBlock x:Name="Hint" Grid.Row="2" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="18,0,18,14"/>
        </Grid>
    </Border>
</Window>
